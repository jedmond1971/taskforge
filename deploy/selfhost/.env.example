# Copy to /opt/jedforge/.env on the VM (mode 600). Never commit the real file.
# bootstrap.sh generates the random values; the Railway-sourced ones come from the handoff file.

# Public origin of the app (no trailing slash). Same domain as Railway keeps OAuth/MCP working.
APP_ORIGIN=https://www.jedforge.com
# Public origin browsers use for presigned file URLs (a second tunnel hostname -> garage:3900).
S3_PUBLIC_ENDPOINT=https://files.jedforge.com
S3_BUCKET=jedforge

# Generated by bootstrap.sh. Garage insists on key id = "GK" + 24 hex chars, secret = 64 hex chars.
# (Each empty value is followed by a blank line: gitleaks' generic-api-key rule otherwise reads the
# next line as the value of an empty secret and flags it.)
POSTGRES_PASSWORD=

S3_ACCESS_KEY=

S3_SECRET_KEY=

AUTH_SECRET=

# Same value as the local .env (Claude Code's tracker key) unless rotated
V1_API_KEY=

# From the handoff file
CLOUDFLARE_TUNNEL_TOKEN=

RESEND_API_KEY=

ALERT_EMAIL_TO=

ALERTING_ENABLED=true
# Set to false to put the instance in read-only-uploads mode during cutover
UPLOADS_ENABLED=true
