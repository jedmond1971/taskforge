# Database
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/taskforge"

# NextAuth.js
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Required by NextAuth v5
AUTH_SECRET="your-secret-here"

# Railway Object Storage (optional — for file attachments)
# Provision a bucket in your Railway project to get these values
RAILWAY_BUCKET_ENDPOINT="https://<region>.storageapi.dev"
RAILWAY_BUCKET_ACCESS_KEY_ID="your-access-key-id"
RAILWAY_BUCKET_SECRET_ACCESS_KEY="your-secret-access-key"
RAILWAY_BUCKET_NAME="your-bucket-name"
RAILWAY_BUCKET_REGION="auto"

# Internal v1 API shared secret — generate with: openssl rand -base64 32
# Set this in Railway environment variables and in your local .env
# Never commit the actual key value to the repository
V1_API_KEY=your-secret-key-here

# Anthropic API key for the in-app AI chat panel (src/app/api/ai/chat)
# Get one from https://console.anthropic.com — never commit the actual value
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional — defaults to claude-sonnet-5 if unset
ANTHROPIC_MODEL=claude-sonnet-5

# AI Chat is exclusive to Jamie's own use of JedForge — must stay unset (or
# "false") on any deployment that isn't Jamie's. Set to "true" only on his
# own Railway instance and local dev.
AI_CHAT_ENABLED=false
